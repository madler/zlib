cmake_minimum_required(VERSION 3.15...3.31)

project(
    minizip_find_package
    LANGUAGES C
    VERSION @minizip_VERSION@)

option(MINIZIP_BUILD_SHARED "" @MINIZIP_BUILD_SHARED@)
option(MINIZIP_BUILD_STATIC "" @MINIZIP_BUILD_STATIC@)

set(MINIZIP_SRCS
    @minizip_SOURCE_DIR@/ioapi.c
    $<$<BOOL:${WIN32}>:@minizip_SOURCE_DIR@/iowin32.c>
    @minizip_SOURCE_DIR@/minizip.c @minizip_SOURCE_DIR@/zip.c)

file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/installed_headers.c
    "#include <zip.h>\n"
    "#include <unzip.h>\n"
    "int main(void) {\n"
    "    unzFile file = unzOpen(\"missing.zip\");\n"
    "    return file ? unzClose(file) : 0;\n"
    "}\n")

if(MINIZIP_BUILD_SHARED)
    find_package(minizip ${minizip_VERSION}
                 CONFIG
                 COMPONENTS shared
                 REQUIRED)
    add_executable(test_example ${MINIZIP_SRCS})
    target_link_libraries(test_example MINIZIP::minizip)
    add_executable(test_installed_headers
                   ${CMAKE_CURRENT_BINARY_DIR}/installed_headers.c)
    target_link_libraries(test_installed_headers MINIZIP::minizip)
endif(MINIZIP_BUILD_SHARED)

if(MINIZIP_BUILD_STATIC)
    find_package(minizip ${minizip_VERSION}
                 CONFIG
                 COMPONENTS static
                 REQUIRED)
    add_executable(test_example_static ${MINIZIP_SRCS})
    target_link_libraries(test_example_static MINIZIP::minizipstatic)
    add_executable(test_installed_headers_static
                   ${CMAKE_CURRENT_BINARY_DIR}/installed_headers.c)
    target_link_libraries(test_installed_headers_static MINIZIP::minizipstatic)
endif(MINIZIP_BUILD_STATIC)
